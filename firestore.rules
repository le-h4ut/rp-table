rules_version = '2';
// Private v0 snapshot: /users/{uid}/boards/main only.
// Required: schemaVersion=1, revision:int incrementing by 1,
// lastMutationId:string(1..100), boardJson:string(2..160000), updatedAt:server timestamp.
// boardJson is an opaque bounded JSON snapshot. The client validates every character,
// grid coordinate and stat before reading/writing. No identity or permissions in JSON.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function validSnapshot() {
      let d = request.resource.data;
      return d.keys().hasAll(['schemaVersion', 'revision', 'lastMutationId', 'boardJson', 'updatedAt'])
        && d.keys().hasOnly(['schemaVersion', 'revision', 'lastMutationId', 'boardJson', 'updatedAt'])
        && d.schemaVersion == 1
        && d.revision is int && d.revision >= 1 && d.revision <= 9007199254740991
        && d.lastMutationId is string && d.lastMutationId.size() > 0 && d.lastMutationId.size() <= 100
        && d.boardJson is string && d.boardJson.size() >= 2 && d.boardJson.size() <= 160000
        && d.updatedAt is timestamp && d.updatedAt == request.time;
    }
    match /users/{uid}/boards/main {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validSnapshot() && request.resource.data.revision == 1;
      allow update: if isOwner(uid) && validSnapshot()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if isOwner(uid);
    }
  }
}
